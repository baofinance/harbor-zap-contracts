# Harbor Zap Contracts — copy to .env.local (gitignored). Sourced by script/_load-env.sh.

# Fork tests (forge test) and mainnet deploy/verify
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# MEGAETH_RPC_URL=https://...   # megaeth deploy only

ETHERSCAN_API_KEY=your_etherscan_api_key
ETHERSCAN_KEY=your_etherscan_api_key   # same value; used by foundry.toml

# ---------------------------------------------------------------------------
# Local Anvil ONLY — leave empty for real networks; set explicitly when needed.
# Foundry account #0 is public by design (see `anvil` banner). Never reuse on mainnet.
#   cast wallet import anvil-default --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
#   DEPLOYER_ACCOUNT=anvil-default
#   OWNER=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# ---------------------------------------------------------------------------
DEPLOYER_ACCOUNT=
OWNER=

# Deploy: yarn deploy --network mainnet --market GOLD --genesis-usdc 0x...
# See README.md for FactoryDeployer deploy + verify scripts.
