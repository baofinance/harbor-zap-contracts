#!/usr/bin/env bash
set -euo pipefail

# Harbor Zaps Deployment Script (CREATE3 + BaoFactory)
#
# Deploys/checks/verifies implementations and ERC1967 proxies for the four zaps:
# - GenesisETHZap_v5
# - GenesisUSDCZap_v5
# - MinterETHZap_v4
# - MinterUSDCZap_v4
#
# Uses CREATE3 via BaoFactory and records deployments in a state file.

usage() {
  cat <<'EOF'
Usage:
  ./script/deploy-zaps --network <network> [options] <mode> [zap...]

Modes:
  --deploy         Deploy implementation + proxy via BaoFactory (full deployment)
  --deploy-impl    Deploy new implementation only (for upgrades; outputs Safe tx)
  --check          Verify deployment: code exists, calls zapName()
  --verify-impl    Verify implementation contract on Etherscan
  --verify         Verify both implementation and proxy on Etherscan

Options:
  --network             Required. Network name (foundry.toml rpc_endpoints key)
  --local               Use local anvil RPC (enables auto-impersonate for operator/owner)
  --salt                Salt prefix for CREATE3 address (default: "harbor_v1")
  --account             Foundry keystore account name (required for non-local deploys)
  --etherscan-api-key   Required for --verify / --verify-impl (non-local)
  --market              Market key used to resolve config addresses (optional)
  --config              Config file path (default: deployments/mainnet/zap-addresses.json)

Zap targets (positional):
  genesis-eth | genesis-usdc | minter-eth | minter-usdc
  If omitted, defaults to all four.

Salt format:
  <salt-prefix>::<zap-key>::zap
  If --market is set, <zap-key> includes the market suffix.

State file:
  Production: deployments/<network>/zaps[-<salt>].json
  Local:      deployments/local/<network>/zaps[-<salt>].json
EOF
}

FORGE=${FORGE:-$HOME/.foundry/bin/forge}
CAST=${CAST:-$HOME/.foundry/bin/cast}

BAO_FACTORY=${BAO_FACTORY:-0xD696E56b3A054734d4C6DCBD32E11a278b0EC458}

NETWORK=""
RPC_NETWORK=""
USE_LOCAL=false
SALT_PREFIX="harbor_v1"
ACCOUNT_NAME=""
MODE=""
ETHERSCAN_API_KEY=""
MARKET=""
CONFIG_FILE=${ZAP_CONFIG_FILE:-deployments/mainnet/zap-addresses.json}
ZAPS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --network)
      NETWORK=${2:-}
      shift 2
      ;;
    --local)
      USE_LOCAL=true
      shift
      ;;
    --salt)
      SALT_PREFIX=${2:-}
      shift 2
      ;;
    --account)
      ACCOUNT_NAME=${2:-}
      shift 2
      ;;
    --etherscan-api-key)
      ETHERSCAN_API_KEY=${2:-}
      shift 2
      ;;
    --market)
      MARKET=${2:-}
      shift 2
      ;;
    --config)
      CONFIG_FILE=${2:-}
      shift 2
      ;;
    --deploy | --deploy-impl | --check | --verify-impl | --verify)
      MODE=${1#--}
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "❌ Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      ZAPS+=("$1")
      shift
      ;;
  esac
done

if [[ ! -f "foundry.toml" ]] || [[ ! -d "src" ]] || [[ ! -d "script" ]]; then
  echo "❌ Must be run from the project root (missing foundry.toml/src/script)" >&2
  exit 1
fi

if [[ -z "$NETWORK" ]]; then
  echo "❌ Missing --network" >&2
  usage >&2
  exit 1
fi

if [[ "$NETWORK" == *"://"* ]] || [[ "$NETWORK" == ws://* ]] || [[ "$NETWORK" == wss://* ]]; then
  echo "❌ --network must be an rpc_endpoints name from foundry.toml, not a URL." >&2
  exit 1
fi

if [[ -z "$MODE" ]]; then
  echo "❌ Missing mode flag. Specify one of: --deploy, --deploy-impl, --check, --verify, --verify-impl" >&2
  usage >&2
  exit 1
fi

if [[ "$USE_LOCAL" == true ]]; then
  RPC_NETWORK="local"
else
  RPC_NETWORK="$NETWORK"
fi

if [[ "$USE_LOCAL" != true ]] && [[ "$MODE" == "deploy" || "$MODE" == "deploy-impl" ]] && [[ -z "$ACCOUNT_NAME" ]]; then
  echo "❌ --account is required when deploying against $NETWORK" >&2
  exit 1
fi

if [[ ${#ZAPS[@]} -eq 0 ]]; then
  ZAPS=(genesis-eth genesis-usdc minter-eth minter-usdc)
fi

validate_zap() {
  case "$1" in
    genesis-eth | genesis-usdc | minter-eth | minter-usdc) ;;
    *)
      echo "❌ Unknown zap target: $1" >&2
      exit 1
      ;;
  esac
}

for zap in "${ZAPS[@]}"; do
  validate_zap "$zap"
done

load_config() {
  local jq_path=$1
  if [[ -f "$CONFIG_FILE" ]]; then
    if ! command -v jq >/dev/null 2>&1; then
      echo "❌ ERROR: jq is required to read $CONFIG_FILE" >&2
      exit 1
    fi
    jq -r "$jq_path // empty" "$CONFIG_FILE"
  fi
}

OWNER=${OWNER:-}
if [[ -z "$OWNER" ]]; then
  OWNER=$(load_config ".owner")
fi

if [[ -z "$OWNER" ]]; then
  echo "❌ ERROR: OWNER is not set (env OWNER or config .owner)" >&2
  exit 1
fi

GENESIS_ETH=${GENESIS_ETH:-}
GENESIS_USDC=${GENESIS_USDC:-}
MINTER_ETH=${MINTER_ETH:-}
MINTER_USDC=${MINTER_USDC:-}

if [[ -n "$MARKET" ]]; then
  [[ -z "$GENESIS_ETH" ]] && GENESIS_ETH=$(load_config ".markets[\"$MARKET\"].addresses.genesisEth")
  [[ -z "$GENESIS_USDC" ]] && GENESIS_USDC=$(load_config ".markets[\"$MARKET\"].addresses.genesisUsdc")
  [[ -z "$MINTER_ETH" ]] && MINTER_ETH=$(load_config ".markets[\"$MARKET\"].addresses.minterEth")
  [[ -z "$MINTER_USDC" ]] && MINTER_USDC=$(load_config ".markets[\"$MARKET\"].addresses.minterUsdc")
fi

REFERRAL_ETH=${REFERRAL_ETH:-0x0000000000000000000000000000000000000000}

CHAIN_ID=$("$CAST" chain-id --rpc-url "$RPC_NETWORK" 2>/dev/null || echo "unknown")

STATE_VERSION="zaps"
STATE_FILE=""
if [[ "$USE_LOCAL" == true ]]; then
  STATE_DIR="deployments/local/${NETWORK}"
else
  STATE_DIR="deployments/${NETWORK}"
fi
mkdir -p "$STATE_DIR"
if [[ "$SALT_PREFIX" == "harbor_v1" ]]; then
  STATE_FILE="${STATE_DIR}/zaps.json"
else
  STATE_FILE="${STATE_DIR}/zaps-${SALT_PREFIX}.json"
fi

init_state_file() {
  if [[ -f "$STATE_FILE" ]]; then
    return
  fi
  local base_obj
  base_obj=$(jq -n \
    --arg version "$STATE_VERSION" \
    --arg network "$NETWORK" \
    --arg chainId "$CHAIN_ID" \
    --arg baoFactory "$BAO_FACTORY" \
    --arg owner "$OWNER" \
    '{
      schemaVersion: 1,
      version: $version,
      network: $network,
      chainId: ($chainId | tonumber),
      baoFactory: $baoFactory,
      owner: $owner,
      implementations: {},
      proxies: {}
    }')

  if [[ -n "$MARKET" ]]; then
    base_obj=$(echo "$base_obj" | jq --arg market "$MARKET" '. + {market: $market}')
  fi
  if [[ "$SALT_PREFIX" != "harbor_v1" ]]; then
    base_obj=$(echo "$base_obj" | jq --arg salt "$SALT_PREFIX" '. + {saltPrefix: $salt}')
  fi

  echo "$base_obj" >"$STATE_FILE"
}

has_code() {
  local addr=$1
  local code
  code=$("$CAST" code "$addr" --rpc-url "$RPC_NETWORK" 2>/dev/null | head -n 1 || echo "0x")
  [[ "$code" != "0x" ]]
}

erc1967_impl_address() {
  local proxy=$1
  local impl
  impl=$("$CAST" implementation "$proxy" --rpc-url "$RPC_NETWORK" 2>/dev/null)
  if [[ -z "$impl" || "$impl" == "0x0000000000000000000000000000000000000000" ]]; then
    echo ""
    return 1
  fi
  "$CAST" to-check-sum-address "$impl"
}

SIGNER_ARGS=()
if [[ -n "$ACCOUNT_NAME" ]]; then
  SIGNER_ARGS=(--account "$ACCOUNT_NAME")
elif [[ "$USE_LOCAL" == true ]]; then
  SIGNER_ARGS=(--private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80)
fi

DEPLOYER=""
if [[ "$MODE" == "deploy" || "$MODE" == "deploy-impl" ]] && [[ ${#SIGNER_ARGS[@]} -gt 0 ]]; then
  DEPLOYER=$("$CAST" wallet address "${SIGNER_ARGS[@]}")
fi

ensure_operator() {
  if [[ "$MODE" != "deploy" ]]; then
    return
  fi
  local is_op
  is_op=$("$CAST" call "$BAO_FACTORY" "isCurrentOperator(address)(bool)" "$DEPLOYER" --rpc-url "$RPC_NETWORK" 2>/dev/null)
  if [[ "$is_op" == "true" ]]; then
    return
  fi
  if [[ "$USE_LOCAL" == true ]]; then
    echo "Setting BaoFactory operator as OWNER (local mode)..."
    if ! "$CAST" send "$BAO_FACTORY" "setOperator(address,uint256)" "$DEPLOYER" 500000 \
      --from "$OWNER" --unlocked --rpc-url "$RPC_NETWORK" --json >/dev/null 2>&1; then
      echo "❌ Failed to call BaoFactory.setOperator as OWNER on local RPC." >&2
      exit 1
    fi
    echo "✓ Operator set (pranked as $OWNER)"
  else
    local set_operator_calldata
    set_operator_calldata=$("$CAST" calldata "setOperator(address,uint256)" "$DEPLOYER" 500000)
    echo "❌ Deployer is not an operator. Execute via Safe before deploying:" >&2
    echo "To:    $BAO_FACTORY" >&2
    echo "Value: 0" >&2
    echo "Data:  $set_operator_calldata" >&2
    exit 1
  fi
}

zap_key() {
  local zap=$1
  if [[ -n "$MARKET" ]]; then
    echo "${zap}-${MARKET}"
  else
    echo "$zap"
  fi
}

salt_for_zap() {
  local zap=$1
  local key
  key=$(zap_key "$zap")
  echo "${SALT_PREFIX}::${key}::zap"
}

predict_address() {
  local zap=$1
  local salt_str salt_b32 predicted
  salt_str=$(salt_for_zap "$zap")
  salt_b32=$("$CAST" keccak "$("$CAST" from-utf8 "$salt_str")")
  predicted=$("$CAST" call "$BAO_FACTORY" "predictAddress(bytes32)(address)" "$salt_b32" --rpc-url "$RPC_NETWORK")
  echo "$predicted"
}

contract_id_for_zap() {
  case "$1" in
    genesis-eth) echo "src/zap/upgradeable/GenesisETHZap_v5.sol:GenesisETHZap_v5" ;;
    genesis-usdc) echo "src/zap/upgradeable/GenesisUSDCZap_v5.sol:GenesisUSDCZap_v5" ;;
    minter-eth) echo "src/zap/upgradeable/MinterETHZap_v4.sol:MinterETHZap_v4" ;;
    minter-usdc) echo "src/zap/upgradeable/MinterUSDCZap_v4.sol:MinterUSDCZap_v4" ;;
  esac
}

contract_name_for_zap() {
  case "$1" in
    genesis-eth) echo "GenesisETHZap_v5" ;;
    genesis-usdc) echo "GenesisUSDCZap_v5" ;;
    minter-eth) echo "MinterETHZap_v4" ;;
    minter-usdc) echo "MinterUSDCZap_v4" ;;
  esac
}

constructor_args_for_zap() {
  case "$1" in
    genesis-eth) echo "$GENESIS_ETH" ;;
    genesis-usdc) echo "$GENESIS_USDC" ;;
    minter-eth) echo "$MINTER_ETH $REFERRAL_ETH" ;;
    minter-usdc) echo "$MINTER_USDC" ;;
  esac
}

constructor_args_encoded_for_zap() {
  case "$1" in
    genesis-eth) "$CAST" abi-encode "constructor(address)" "$GENESIS_ETH" ;;
    genesis-usdc) "$CAST" abi-encode "constructor(address)" "$GENESIS_USDC" ;;
    minter-eth) "$CAST" abi-encode "constructor(address,address)" "$MINTER_ETH" "$REFERRAL_ETH" ;;
    minter-usdc) "$CAST" abi-encode "constructor(address)" "$MINTER_USDC" ;;
  esac
}

init_data_for_zap() {
  case "$1" in
    genesis-eth) "$CAST" calldata "initialize(address,address,address)" "$DEPLOYER" "$OWNER" "$REFERRAL_ETH" ;;
    genesis-usdc) "$CAST" calldata "initialize(address,address)" "$DEPLOYER" "$OWNER" ;;
    minter-eth) "$CAST" calldata "initialize(address,address,address)" "$DEPLOYER" "$OWNER" "$REFERRAL_ETH" ;;
    minter-usdc) "$CAST" calldata "initialize(address,address)" "$DEPLOYER" "$OWNER" ;;
  esac
}

require_addresses_for_zap() {
  case "$1" in
    genesis-eth)
      [[ -z "$GENESIS_ETH" ]] && { echo "❌ GENESIS_ETH is not set" >&2; exit 1; }
      ;;
    genesis-usdc)
      [[ -z "$GENESIS_USDC" ]] && { echo "❌ GENESIS_USDC is not set" >&2; exit 1; }
      ;;
    minter-eth)
      [[ -z "$MINTER_ETH" ]] && { echo "❌ MINTER_ETH is not set" >&2; exit 1; }
      ;;
    minter-usdc)
      [[ -z "$MINTER_USDC" ]] && { echo "❌ MINTER_USDC is not set" >&2; exit 1; }
      ;;
  esac
}

record_implementation() {
  local zap=$1
  local impl=$2
  local contract_id=$3
  local contract_name=$4
  local ctor_encoded=$5
  local timestamp
  timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

  local tmp
  tmp=$(mktemp)
  jq \
    --arg zapKey "$(zap_key "$zap")" \
    --arg contractId "$contract_id" \
    --arg contractName "$contract_name" \
    --arg ctorEncoded "$ctor_encoded" \
    --arg addr "$impl" \
    --arg ts "$timestamp" \
    '.implementations[$addr] = {
      zapKey: $zapKey,
      contractId: $contractId,
      contractName: $contractName,
      constructorArgsEncoded: $ctorEncoded,
      deployedAt: $ts
    }' \
    "$STATE_FILE" >"$tmp" && mv "$tmp" "$STATE_FILE"
}

record_proxy() {
  local zap=$1
  local address=$2
  local impl=$3
  local init_data=$4
  local timestamp
  timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  local key salt
  key=$(zap_key "$zap")
  salt=$(salt_for_zap "$zap")

  local tmp
  tmp=$(mktemp)
  jq \
    --arg key "$key" \
    --arg salt "$salt" \
    --arg addr "$address" \
    --arg impl "$impl" \
    --arg init "$init_data" \
    --arg ts "$timestamp" \
    '.proxies[$key] = {
      salt: $salt,
      address: $addr,
      implementation: $impl,
      initData: $init,
      deployedAt: $ts
    }' \
    "$STATE_FILE" >"$tmp" && mv "$tmp" "$STATE_FILE"
}

get_latest_impl_for_zap() {
  jq -r --arg key "$(zap_key "$1")" \
    '[.implementations | to_entries[] | select(.value.zapKey == $key)] | sort_by(.value.deployedAt) | last | .key // empty' \
    "$STATE_FILE"
}

init_state_file

case "$MODE" in
  deploy)
    ensure_operator
    ;;
  verify | verify-impl)
    if [[ -z "$ETHERSCAN_API_KEY" ]] && [[ "$USE_LOCAL" == false ]]; then
      echo "❌ --etherscan-api-key is required for --verify/--verify-impl (unless --local)" >&2
      exit 1
    fi
    ;;
esac

for zap in "${ZAPS[@]}"; do
  require_addresses_for_zap "$zap"

  contract_id=$(contract_id_for_zap "$zap")
  contract_name=$(contract_name_for_zap "$zap")
  ctor_encoded=$(constructor_args_encoded_for_zap "$zap")
  predicted=$(predict_address "$zap")

  echo ""
  echo "═══════════════════════════════════════════════════════════"
  echo "  ZAP:   $zap"
  echo "  Key:   $(zap_key "$zap")"
  echo "  Salt:  $(salt_for_zap "$zap")"
  echo "  Pred:  $predicted"
  echo "═══════════════════════════════════════════════════════════"

  case "$MODE" in
    check)
      if ! has_code "$predicted"; then
        echo "❌ Not deployed (no code at predicted address)"
        continue
      fi
      if ! name=$("$CAST" call "$predicted" "zapName()(string)" --rpc-url "$RPC_NETWORK" 2>&1); then
        echo "⚠️  zapName() call failed"
      else
        echo "✅ zapName: $(tr -d '"' <<<"$name")"
      fi
      current_impl=$(erc1967_impl_address "$predicted" || true)
      if [[ -n "$current_impl" ]]; then
        echo "   implementation: $current_impl"
      fi
      ;;

    deploy-impl)
      echo "Deploying implementation: $contract_id"
      if ! out=$("$FORGE" create "$contract_id" --rpc-url "$RPC_NETWORK" "${SIGNER_ARGS[@]}" --broadcast 2>&1); then
        echo "❌ Deployment failed:" >&2
        echo "$out" | sed 's/^/     /' >&2
        continue
      fi
      impl=$(grep -Eo "Deployed to: 0x[0-9a-fA-F]{40}" <<<"$out" | awk '{print $3}')
      if [[ -z "$impl" ]]; then
        echo "❌ Failed to parse implementation address" >&2
        continue
      fi
      echo "✅ Implementation deployed: $impl"
      record_implementation "$zap" "$impl" "$contract_id" "$contract_name" "$ctor_encoded"

      if has_code "$predicted"; then
        upgrade_calldata=$("$CAST" calldata "upgradeToAndCall(address,bytes)" "$impl" "0x")
        echo "Proxy already deployed at $predicted"
        echo "Safe Transaction Builder (upgradeToAndCall):"
        echo "  To:        $predicted"
        echo "  Value:     0"
        echo "  Data:      $upgrade_calldata"
      fi
      ;;

    deploy)
      if has_code "$predicted"; then
        echo "❌ Proxy already deployed at $predicted"
        continue
      fi

      echo "Deploying implementation: $contract_id"
      if ! out=$("$FORGE" create "$contract_id" --rpc-url "$RPC_NETWORK" "${SIGNER_ARGS[@]}" --broadcast 2>&1); then
        echo "❌ Deployment failed:" >&2
        echo "$out" | sed 's/^/     /' >&2
        continue
      fi
      impl=$(grep -Eo "Deployed to: 0x[0-9a-fA-F]{40}" <<<"$out" | awk '{print $3}')
      if [[ -z "$impl" ]]; then
        echo "❌ Failed to parse implementation address" >&2
        continue
      fi
      echo "✅ Implementation deployed: $impl"
      record_implementation "$zap" "$impl" "$contract_id" "$contract_name" "$ctor_encoded"

      init_data=$(init_data_for_zap "$zap")

      proxy_bytecode=$("$FORGE" inspect ERC1967Proxy bytecode)
      proxy_args=$("$CAST" abi-encode "constructor(address,bytes)" "$impl" "$init_data")
      init_code="${proxy_bytecode}${proxy_args:2}"

      echo "Deploying proxy via BaoFactory..."
      salt_str=$(salt_for_zap "$zap")
      salt_b32=$("$CAST" keccak "$("$CAST" from-utf8 "$salt_str")")
      if ! tx=$("$CAST" send "$BAO_FACTORY" "deploy(bytes,bytes32)(address)" "$init_code" "$salt_b32" \
        --rpc-url "$RPC_NETWORK" "${SIGNER_ARGS[@]}" --json 2>&1); then
        echo "❌ Proxy deployment failed:" >&2
        echo "$tx" | sed 's/^/     /' >&2
        continue
      fi

      tx_hash=$(jq -r '.transactionHash // empty' <<<"$tx" 2>/dev/null)
      if [[ -z "$tx_hash" ]]; then
        echo "❌ Failed to get transaction hash" >&2
        continue
      fi
      echo "✓ Tx: $tx_hash"

      echo "⏳ Waiting for confirmation..."
      max_attempts=60
      attempt=0
      confirmed=false
      while [[ $attempt -lt $max_attempts ]]; do
        if receipt=$("$CAST" receipt "$tx_hash" --rpc-url "$RPC_NETWORK" --json 2>/dev/null); then
          status=$(jq -r '.status // empty' <<<"$receipt" 2>/dev/null)
          if [[ "$status" == "0x1" ]] || [[ "$status" == "1" ]]; then
            block=$(jq -r '.blockNumber // empty' <<<"$receipt" 2>/dev/null)
            echo "✓ Confirmed in block $block"
            confirmed=true
            break
          elif [[ "$status" == "0x0" ]] || [[ "$status" == "0" ]]; then
            echo "❌ Transaction reverted"
            break
          fi
        fi
        sleep 1
        ((++attempt))
      done

      if [[ "$confirmed" != "true" ]]; then
        echo "❌ Deployment not confirmed"
        continue
      fi

      if ! has_code "$predicted"; then
        echo "❌ No code at predicted address after deployment"
        continue
      fi
      echo "✅ Proxy deployed: $predicted"
      record_proxy "$zap" "$predicted" "$impl" "$init_data"
      ;;

    verify-impl)
      impl=$(get_latest_impl_for_zap "$zap")
      if [[ -z "$impl" ]]; then
        echo "❌ No implementation found in state for $zap"
        continue
      fi
      echo "Verifying implementation: $impl"
      if ! "$FORGE" verify-contract \
        "$impl" \
        "$contract_id" \
        --verifier etherscan \
        --etherscan-api-key "$ETHERSCAN_API_KEY" \
        --compiler-version 0.8.30 \
        --chain "$NETWORK"; then
        echo "❌ Verification failed"
      else
        echo "✅ Implementation verified"
      fi
      ;;

    verify)
      proxy_addr=$(jq -r --arg key "$(zap_key "$zap")" '.proxies[$key].address // empty' "$STATE_FILE")
      impl_addr=$(jq -r --arg key "$(zap_key "$zap")" '.proxies[$key].implementation // empty' "$STATE_FILE")
      init_data=$(jq -r --arg key "$(zap_key "$zap")" '.proxies[$key].initData // empty' "$STATE_FILE")

      if [[ -z "$proxy_addr" || -z "$impl_addr" || -z "$init_data" ]]; then
        echo "❌ Missing proxy data in state for $zap"
        continue
      fi

      echo "Verifying implementation: $impl_addr"
      "$FORGE" verify-contract \
        "$impl_addr" \
        "$contract_id" \
        --verifier etherscan \
        --etherscan-api-key "$ETHERSCAN_API_KEY" \
        --compiler-version 0.8.30 \
        --chain "$NETWORK" || echo "⚠ Implementation verification failed (continuing)"

      proxy_path="lib/openzeppelin-contracts-upgradeable/lib/openzeppelin-contracts/contracts/proxy/ERC1967/ERC1967Proxy.sol:ERC1967Proxy"
      proxy_args=$("$CAST" abi-encode "constructor(address,bytes)" "$impl_addr" "$init_data")
      echo "Verifying proxy: $proxy_addr"
      if ! "$FORGE" verify-contract \
        "$proxy_addr" \
        "$proxy_path" \
        --verifier etherscan \
        --etherscan-api-key "$ETHERSCAN_API_KEY" \
        --constructor-args "$proxy_args" \
        --compiler-version 0.8.30 \
        --chain "$NETWORK"; then
        echo "❌ Proxy verification failed"
      else
        echo "✅ Proxy verified"
      fi
      ;;
  esac
done
